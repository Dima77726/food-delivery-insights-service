<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.5</version>
        <relativePath/>
    </parent>

    <groupId>com.dima</groupId>
    <version>0.0.1-SNAPSHOT</version>
    <artifactId>insights-service</artifactId>
    <name>insights-service</name>
    <description>Отзывы, аналитика и рекомендации; GraphQL для экранов клиента</description>

    <properties>
        <java.version>21</java.version>
        <!-- Ветка 3.x springdoc — единственная, совместимая со Spring Boot 4 / Framework 7. -->
        <springdoc.version>3.1.0</springdoc.version>
        <!-- Версия контрактов своя, отдельно от версии сервиса: см. food-delivery-contracts. -->
        <contracts.version>1.0.0</contracts.version>
        <spring-grpc.version>1.0.3</spring-grpc.version>
        <protobuf-java.version>4.33.4</protobuf-java.version>
        <resilience4j.version>2.3.0</resilience4j.version>
        <clickhouse-jdbc.version>0.9.9</clickhouse-jdbc.version>
    </properties>

    <!--
        Последний вынесенный сервис — и последнее, что оставалось от монолита. Модуль service
        переименован сюда целиком: в нём к этому этапу жили только отзывы (MongoDB), аналитика
        (ClickHouse) и рекомендации (Neo4j). PostgreSQL сервису не нужен вовсе: системой записи
        для заказов стал order-service, а здесь живут только производные данные и отзывы.

        Наружу — прежний REST и GraphQL. GraphQL здесь потому, что экраны клиента собирают
        данные из нескольких источников сразу: ресторан из каталога, рейтинг и отзывы из MongoDB,
        похожие блюда из графа. Одним запросом клиент берёт ровно те поля, что нужны экрану.
    -->

    <!--
        Контракты платформы — в GitHub Packages репозитория food-delivery-contracts. Читать оттуда
        нужен токен даже для публичных пакетов: см. README контрактов (settings.xml с сервером github).
    -->
    <repositories>
        <repository>
            <id>github</id>
            <url>https://maven.pkg.github.com/Dima77726/food-delivery-contracts</url>
        </repository>
    </repositories>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.dima</groupId>
                <artifactId>event-contracts</artifactId>
                <version>${contracts.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dima</groupId>
                <artifactId>grpc-contracts</artifactId>
                <version>${contracts.version}</version>
            </dependency>
            <dependency>
                <groupId>com.dima</groupId>
                <artifactId>food-delivery-client</artifactId>
                <version>${contracts.version}</version>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf-java.version}</version>
            </dependency>
            <dependency>
                <groupId>org.springframework.grpc</groupId>
                <artifactId>spring-grpc-dependencies</artifactId>
                <version>${spring-grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-circuitbreaker</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
            <dependency>
                <groupId>io.github.resilience4j</groupId>
                <artifactId>resilience4j-micrometer</artifactId>
                <version>${resilience4j.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Контракт событий заказа: аналитика их читает. -->
        <dependency>
            <groupId>com.dima</groupId>
            <artifactId>event-contracts</artifactId>
        </dependency>

        <!--
            gRPC — только клиент: сервис заказов (заказ для отзыва и графа), сервис пользователей
            (права на ресторан для аналитики), каталог (название и город ресторана для GraphQL).
        -->
        <dependency>
            <groupId>com.dima</groupId>
            <artifactId>grpc-contracts</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.grpc</groupId>
            <artifactId>spring-grpc-client-spring-boot-starter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-graphql</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-micrometer-metrics</artifactId>
        </dependency>

        <!--
            Трассировка: Micrometer Tracing поверх OpenTelemetry, спаны уходят по OTLP в Tempo.
            Стартер тянет ещё micrometer-registry-otlp — метрики по OTLP отключены в
            application.yml, их по-прежнему снимает Prometheus.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-opentelemetry</artifactId>
        </dependency>

        <!-- Предохранитель на исходящих gRPC-вызовах; см. CircuitBreakerClientInterceptor. -->
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-circuitbreaker</artifactId>
        </dependency>
        <dependency>
            <groupId>io.github.resilience4j</groupId>
            <artifactId>resilience4j-micrometer</artifactId>
        </dependency>

        <dependency>
            <groupId>io.micrometer</groupId>
            <artifactId>micrometer-registry-prometheus</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-kafka</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>${springdoc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!--
            ============================ Хранилища ============================================

            Каждое взято под свою задачу, и способ доступа у каждого свой:

              mongo         — Spring Data MongoDB: репозитории и aggregation pipeline (отзывы);
              neo4j         — голый драйвер Neo4j, Cypher руками (рекомендации);
              clickhouse    — JdbcTemplate поверх собственного пула, SQL руками (аналитика).

            Все три выключаемы (app.stores.*.enabled): выключенный модуль просто не поднимается,
            а его поля в GraphQL отвечают ошибкой «модуль выключен».

            Для ClickHouse нужны JdbcTemplate и Hikari, но не стартер JDBC: его автоконфигурация
            потребовала бы основной DataSource, а основной базы у сервиса нет.
        -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-mongodb</artifactId>
        </dependency>

        <!-- Версией управляет spring-boot-dependencies (neo4j-java-driver.version). -->
        <dependency>
            <groupId>org.neo4j.driver</groupId>
            <artifactId>neo4j-java-driver</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-jdbc</artifactId>
        </dependency>

        <dependency>
            <groupId>com.zaxxer</groupId>
            <artifactId>HikariCP</artifactId>
        </dependency>

        <!-- ClickHouse Spring Boot не знает, поэтому версия задана явно в родительском pom. -->
        <dependency>
            <groupId>com.clickhouse</groupId>
            <artifactId>clickhouse-jdbc</artifactId>
            <version>${clickhouse-jdbc.version}</version>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-graphql-test</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.grpc</groupId>
            <artifactId>spring-grpc-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- Сгенерированный SDK — для контрактных тестов REST этого сервиса. -->
        <dependency>
            <groupId>com.dima</groupId>
            <artifactId>food-delivery-client</artifactId>
            <version>${contracts.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-kafka</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-mongodb</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-neo4j</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-clickhouse</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- classifier=exec: общий Dockerfile ищет исполняемый jar по одному шаблону. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <classifier>exec</classifier>
                    <excludes>
                        <exclude>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
